data: {"candidates": [{"content": {"parts": [{"text": "Jasper was a creature of habit, and his most cherished habit was napping. He was a magnificent ginger tabby, thick-furred and well-fed, and his days revolved around the sun's slow journey across the living room"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 47,"totalTokenCount": 1148,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " floor.\n\nHis prime spot was a patch of sunbeam near the large bay window. Here, golden motes danced in the air, and the warmth seeped into his bones, rendering him a purring, contented puddle of fur. From"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 96,"totalTokenCount": 1197,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " this vantage point, Jasper would occasionally crack an eye open, observe the world – a passing bird, a leaf skittering across the patio, the distant hum of a lawnmower – and then, with a sigh that was almost a g"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 145,"totalTokenCount": 1246,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": "urgle, drift back into slumber.\n\nHis humans, a kind couple named Sarah and Tom, often joked that Jasper was the \"zen master of idleness.\" They didn't know the half of it.\n\nOne Tuesday afternoon, the usual"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 195,"totalTokenCount": 1296,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " peace was shattered. A high-pitched, distressed wail erupted from the kitchen. It wasn't the usual \"feed me\" meow, nor the \"I've caught something\" yowl. This was a sound of genuine"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 243,"totalTokenCount": 1344,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " panic.\n\nJasper's ears, which had been flattened in blissful sleep, swiveled instantly. His tail, previously limp, gave a sharp twitch. His golden eyes snapped open, no longer soft with dreams, but sharp and alert. The"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 293,"totalTokenCount": 1394,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " wail came again, louder this time. It was Lily, Sarah and Tom's toddler, who usually spent her afternoons napping in her crib.\n\nWithout a second thought, Jasper launched himself from the sunbeam. He moved with a speed that"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 344,"totalTokenCount": 1445,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " belied his usual languor, a blur of ginger fur streaking across the polished floorboards. He rounded the corner into the kitchen to find Lily on the floor, her face red and tear-streaked, a large mixing bowl prec"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 392,"totalTokenCount": 1493,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": "ariously balanced on her head. She had evidently been trying to reach a cookie jar on the counter, pulled the bowl down, and gotten stuck.\n\nJasper didn't try to remove the bowl. He knew his limits. Instead, he"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 440,"totalTokenCount": 1541,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " did what he did best: he offered comfort. He weaved between Lily's flailing legs, purring a rumbling motor that vibrated through her small body. He rubbed his soft head against her arm, then playfully batted at her tiny"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 490,"totalTokenCount": 1591,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " foot.\n\nThe unexpected tickle, the soothing rumble, the familiar warmth of his fur – it broke through Lily's panic. Her wails subsided into hiccuping sobs, then a watery giggle as Jasper playfully nipped at"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 538,"totalTokenCount": 1639,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " her shoelace.\n\nJust then, Sarah rushed in, alerted by the sudden silence after the wails. She saw Lily, still with the bowl on her head, but now giggling and trying to pet Jasper. Sarah quickly lifted the bowl, scooped"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 589,"totalTokenCount": 1690,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

data: {"candidates": [{"content": {"parts": [{"text": " up her daughter, and then, with a knowing smile, gently scratched Jasper behind the ears.\n\n\"You're a good boy, Jasper,\" she murmured. \"My little hero.\"\n\nJasper, having completed his mission, accepted the praise with a"}],"role": "model"},"index": 0}],"usageMetadata": {"promptTokenCount": 9,"candidatesTokenCount": 640,"totalTokenCount": 1741,"promptTokensDetails": [{"modality": "TEXT","tokenCount": 9}],"thoughtsTokenCount": 1092,"serviceTier": "standard"},"modelVersion": "gemini-2.5-flash","responseId": "dPNVaqTPK7qWvdIP3PrxcA"}

